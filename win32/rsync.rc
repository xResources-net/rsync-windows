#include <windows.h>
/* Generated by build-win.ps1 into the object dir: RSYNC_RC_VER_NUM,
 * RSYNC_RC_VER_STR, RSYNC_RC_BUILD (arch/toolchain), RSYNC_RC_YEAR. */
#include "rsync-version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "rsync.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RSYNC_RC_VER_NUM
PRODUCTVERSION  RSYNC_RC_VER_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "rsync project (https://rsync.samba.org)"
      VALUE "FileDescription",  "rsync - fast incremental file transfer"
      VALUE "FileVersion",      RSYNC_RC_VER_STR
      VALUE "InternalName",     "rsync"
      VALUE "LegalCopyright",   "Copyright (C) 1996-" RSYNC_RC_YEAR " Andrew Tridgell, Wayne Davison, and others. GPLv3."
      VALUE "OriginalFilename", "rsync.exe"
      VALUE "ProductName",      "rsync"
      VALUE "ProductVersion",   RSYNC_RC_VER_STR
      VALUE "Comments",         "Native Win32 build (" RSYNC_RC_BUILD "), zig cc; no cygwin1.dll / msys-2.0.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
